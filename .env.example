# Required before `docker compose up`. Copy this file to .env and fill the secrets.
# Compose refuses to start if the required values are missing.
POSTGRES_PASSWORD=
JWT_SECRET=
PII_ENCRYPTION_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=
CRON_SECRET=

# Postgres for the Next.js presale routes. Compose binds it to 127.0.0.1:5433 only.
# Percent-encode the password if it contains @ : / ? # or other reserved characters.
DATABASE_URL=postgresql://oxxx:oxxx@localhost:5433/oxxx

# 0 ignores X-Forwarded-For. Set to 1 when a single reverse proxy sits in front of the API.
TRUST_PROXY_HOPS=0

# Admin console origin. Cookies stay on the API host and are not shared with the public site.
# See docs/admin-api.md.
ADMIN_CONSOLE_ORIGIN=
ADMIN_IP_ALLOWLIST=

# Required in production for the public presale rate limit. Local dev falls back to memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin API details are in backend/.env.example.

# First BSC block to scan. Leave empty to start at the current safe head (no history).
PRESALE_INDEX_START_BLOCK=

# Optional comma-separated BSC RPC URLs. Defaults to public BSC dataseeds.
PRESALE_RPC_URLS=

# Indexer batching. Each cron invocation scans at most this many blocks.
PRESALE_INDEX_CHUNK_SIZE=2000
PRESALE_INDEX_MAX_BLOCKS=5000
PRESALE_INDEX_BUDGET_MS=20000

# Reconciliation alerts. Default channels are log + webhook.
# Webhook is skipped when the URL is empty. Add your own channel in code via AlertChannel.
PRESALE_ALERT_CHANNELS=log,webhook
PRESALE_ALERT_WEBHOOK_URL=
