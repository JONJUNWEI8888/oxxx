{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --schema prisma/schema.prisma && next build",
    "start": "next start",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "test": "vitest run && pnpm --filter @oxxx/admin test",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "presale:index": "node --env-file-if-exists=.env --import tsx scripts/presale-indexer.ts",
    "presale:reconcile": "node --env-file-if-exists=.env --import tsx scripts/presale-indexer.ts --reconcile"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@prisma/client": "^6.19.0",
    "@react-three/drei": "^10.7.9",
