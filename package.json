    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.35.6",
    "@vercel/analytics": "1.6.1",
    "@vercel/functions": "^3.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "framer-motion": "^12.43.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.16.0",
    "next": "16.4.0",
    "ogl": "^1.0.11",
    "prisma": "^6.19.0",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@noble/hashes": "^2.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "5.7.3",
    "vitest": "^3.2.4"
  }
}
