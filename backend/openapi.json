{
  "openapi": "3.0.3",
  "info": {
    "title": "OXXX Admin API",
    "version": "1.0.0",
    "description": "Admin API for the separate admin console. Authorization is enforced on the server. GET /api/v1/auth/me returns permissions only so the UI can hide controls. Browser sessions use host-only httpOnly cookies (no Domain attribute, so they are not shared with the public site) plus an X-CSRF-Token header on cookie-authenticated mutations. CORS allows only ADMIN_CONSOLE_ORIGIN when that variable is set. ADMIN_IP_ALLOWLIST, when non-empty, restricts auth and admin routes using request.ip after TRUST_PROXY_HOPS. Responses under /api and /docs send X-Robots-Tag: noindex."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "oxxx_admin_access"
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      }
    },
    "schemas": {}
  },
