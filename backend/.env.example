# Copy to backend/.env or export these before `pnpm --filter @oxxx/admin dev`.
# Compose reads the repo-root .env and refuses to start when a required secret is missing.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# Percent-encode the password if it contains @ : / ? # or other reserved characters.
# Runtime connection. Production should be the oxxx_app role, not the owner.
DATABASE_URL=postgresql://oxxx:oxxx@localhost:5433/oxxx
# Owner connection used only for migrations and prisma/production-app-role.sql.
DATABASE_MIGRATION_URL=

# Password for the oxxx_app role. Required in production. Dev and test may leave it empty.
APP_DB_PASSWORD=

# HS256 secret, at least 32 characters.
JWT_SECRET=

# HMAC key for CSRF tokens, at least 32 characters. Required in production.
# Do not reuse JWT_SECRET.
CSRF_SECRET=

# 32-byte key, base64 or 64-char hex. Encrypts user email/phone, KYC profile, and TOTP secrets.
PII_ENCRYPTION_KEY=

# Admin console origin (scheme + host + port, no path). This is the only browser
# origin allowed to call the API with credentials. Example: https://admin.oxxx.io
# When set, ADMIN_CORS_ORIGINS is ignored.
ADMIN_CONSOLE_ORIGIN=

# Legacy comma-separated origins, used only when ADMIN_CONSOLE_ORIGIN is empty.
ADMIN_CORS_ORIGINS=http://localhost:3000

# Comma-separated IPs and CIDRs. Production refuses to start when this is empty.
# Uses request.ip after TRUST_PROXY_HOPS. Only /health is exempt.
ADMIN_IP_ALLOWLIST=
# Exact value "true" allows every client IP and logs a security warning. Anything else is ignored.
ADMIN_IP_ALLOWLIST_DISABLED=

# local writes signed URLs that only this API can redeem. s3 uses an S3-compatible bucket.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./var/storage
PUBLIC_BASE_URL=http://localhost:4000
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Shared with the Next.js cron routes.
CRON_SECRET=

# First boot creates this super admin. Password must be at least 12 characters.
# Leave ADMIN_TOTP_SECRET unset in development to print a generated secret once.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=
ADMIN_RESET_PASSWORD=false

ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_MAX_FAILURES=8
LOGIN_WINDOW_SEC=900
RATE_LIMIT_MAX=300

# Trusted proxy hops for request.ip. 0 ignores X-Forwarded-For.
TRUST_PROXY_HOPS=0

# Presale indexer. See docs/presale-api.md.
PRESALE_INDEX_START_BLOCK=
PRESALE_RPC_URLS=
PRESALE_ALERT_CHANNELS=log,webhook
PRESALE_ALERT_WEBHOOK_URL=
